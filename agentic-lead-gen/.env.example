# Copy to .env and fill in (never commit .env)
ANTHROPIC_API_KEY=        # https://platform.claude.com   (required)
TYPESAFE_API_KEY=         # https://console.typesafe.ai/keys  (optional — LLM fallback scorer if unset)

# --- LangSmith observability (optional — tracing is a no-op if unset) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=        # https://smith.langchain.com
LANGSMITH_PROJECT=agentic-lead-gen

# Optional model override:
# CHAT_MODEL=claude-haiku-4-5

# Note: lead data comes from OpenStreetMap (Nominatim + Overpass) — free, no key.
