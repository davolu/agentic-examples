# Copy to .env and fill in (never commit .env)
ANTHROPIC_API_KEY=        # https://platform.claude.com   (required)
TYPESAFE_API_KEY=         # https://console.typesafe.ai/keys  (optional — LLM fallback router if unset)

# --- LangSmith observability (optional — tracing is a no-op if unset) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=        # https://smith.langchain.com
LANGSMITH_PROJECT=support-copilot

# --- Memory backend: Pinecone if set, else local Chroma (default) ---
# PINECONE_API_KEY=       # https://app.pinecone.io
# PINECONE_INDEX=copilot-memory
# PINECONE_EMBED_MODEL=llama-text-embed-v2

# Optional model overrides:
# CHAT_MODEL=claude-haiku-4-5
# JEV_MODEL=jev-latest
